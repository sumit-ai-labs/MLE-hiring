# Copy this file to .env and fill in your keys
# Never commit .env to version control

# LLM API Keys (use whichever you prefer)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Optional. Leave unset for deterministic default behavior.
ENABLE_GEMINI_POLISH=

# Optional: Embedding model keys
COHERE_API_KEY=
VOYAGE_API_KEY=
